{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose exec -T api npx tsc:*)",
      "Bash(docker compose exec -T api npm test:*)",
      "Bash(docker compose exec -T api npx vitest:*)",
      "Bash(docker compose exec -T web npx tsc:*)",
      "Bash(docker compose exec -T web npm run lint:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(bash .claude/hooks/quality-gate.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(curl -s http://localhost:300:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./api/prisma/migrations/**/migration.sql)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*--force-reset*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
