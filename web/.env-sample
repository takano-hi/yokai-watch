# OpenAI API (Next.js ルートハンドラ経由で直接呼ぶ場合)
CHATGPT_API_KEY=

# Vercel image generation API (サーバー専用)
IMAGE_GENERATION_API_TOKEN=
OPENAI_IMAGE_MODEL=gpt-6-luna
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_API_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=

# API サーバー URL (docker-compose では自動設定されるため、ローカル単体起動時のみ必要)
NEXT_PUBLIC_API_URL=

# Cloudflare R2 パブリック URL（例: https://pub-xxx.r2.dev または https://images.yourdomain.com）
NEXT_PUBLIC_R2_BASE_URL=
